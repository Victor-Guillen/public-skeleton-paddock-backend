<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Le Main généré par xUnit bloque sur une tâche (GetAwaiter().GetResult()) : on désactive les avertissements de ce seul fichier. -->
    <DefineConstants>$(DefineConstants);XUNIT_GENERATED_DISABLE_WARNINGS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.eNhancedEdition" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Paddock.Api\Paddock.Api.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Paddock.BuildingBlocks\Paddock.BuildingBlocks.csproj" />
  </ItemGroup>

</Project>
